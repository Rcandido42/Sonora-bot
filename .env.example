# ==============================================================================
# SONORA — Configuração de Ambiente (.env)
# ==============================================================================
# Copia este ficheiro para ".env" na raiz do projeto e preenche os valores.
# NUNCA partilhes nem adiciones o ficheiro ".env" ao controlo de versões (Git).
# ==============================================================================

# Ambiente de execução: development | production | test
NODE_ENV=development

# Idioma predefinido do sistema: pt-PT | en
DEFAULT_LANGUAGE=pt-PT

# Nível de registo (logs): trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. Bot Discord & Servidor (Obrigatório para ligar ao Discord)
# Obtém estes dados em: https://discord.com/developers/applications
# ------------------------------------------------------------------------------
DISCORD_TOKEN=coloca_aqui_o_token_do_bot_sonora
DISCORD_CLIENT_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000

# ------------------------------------------------------------------------------
# 2. Autenticação Discord OAuth2 & Sessões do Painel Web
# ------------------------------------------------------------------------------
DISCORD_CLIENT_SECRET=coloca_aqui_o_client_secret_oauth2
# URL de callback configurado na secção OAuth2 -> Redirects do Discord Developer Portal
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Segredo criptográfico para assinar cookies e sessões (mínimo 32 caracteres aleatórios)
# Exemplo para gerar no PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET=altera_este_segredo_para_uma_string_aleatoria_com_pelo_menos_32_caracteres

# Tempo de vida da sessão em segundos (predefinido: 604800 = 7 dias)
SESSION_TTL_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. Servidor API, Painel Web & Acesso Remoto
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3001

# URL público do painel web (usado para CORS, redirecionamento pós-login e links).
# Em desenvolvimento local: http://localhost:5173
# Em acesso remoto via Cloudflare Tunnel / HTTPS: https://sonora.teudominio.pt
PUBLIC_WEB_URL=http://localhost:5173

# Ativa trustProxy=true quando o backend estiver atrás de um túnel HTTPS seguro (ex: Cloudflare Tunnel)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 4. Base de Dados SQLite & Cópias de Segurança
# ------------------------------------------------------------------------------
DATABASE_PATH=./data/sonora.db
BACKUP_DIR=./backups

# ------------------------------------------------------------------------------
# 5. Integrações de Metadados e Letras (Opcionais)
# ------------------------------------------------------------------------------
# Spotify Web API (Opcional: utilizado APENAS para identificar músicas e metadados).
# Sem estas chaves, a Sonora utiliza o endpoint público oEmbed oficial do Spotify para faixas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API (Opcional: para obter ligações oficiais de letras quando não disponíveis no LRCLIB)
GENIUS_ACCESS_TOKEN=

# URL base da API pública de letras LRCLIB
LRCLIB_API_URL=https://lrclib.net/api

# ------------------------------------------------------------------------------
# 6. Motor de Áudio e Binários Externos (Opcionais)
# ------------------------------------------------------------------------------
# Se deixado em branco, utiliza automaticamente o binário do pacote "ffmpeg-static"
FFMPEG_PATH=

# Caminho opcional para o executável yt-dlp (ex: C:\caminho\para\yt-dlp.exe ou "yt-dlp")
YTDLP_PATH=

# Permitir URLs de áudio direto via HTTP não encriptado (apenas para fontes públicas; IPs privados são sempre bloqueados)
ALLOW_INSECURE_DIRECT_AUDIO_HTTP=false
